<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  Java 17 build of unlaxer-common (#311). Same sources, resources and tests as ../unlaxer-common
	  (one source tree), compiled with release 17 and published as org.unlaxer:unlaxer-common-jdk17.
	  Drop-in replacement for Java 17 JVMs: same packages and classes, class file major 61.
	  Tests run automatically on a Java 17 JVM (profile jdk17-tests); on newer JDKs pass
	  the property unlaxer.jdk17.skipTests=false to run them against this build.
	-->
	<parent>
		<groupId>org.unlaxer</groupId>
		<artifactId>unlaxer-parser</artifactId>
		<version>${revision}</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<groupId>org.unlaxer</groupId>
	<artifactId>unlaxer-common-jdk17</artifactId>
	<name>unlaxer-common-jdk17</name>
	<packaging>jar</packaging>

	<description>Unlaxer parser combinator inspired by RelaxNG (Java 17 build of unlaxer-common)</description>
	<url>https://github.com/opaopa6969/unlaxer-parser</url>

	<developers>
		<developer>
			<id>opaopa6969</id>
			<name>hisayuki ookubo</name>
			<email>opaopa6969@gmail.com</email>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:git@github.com:opaopa6969/unlaxer-parser.git</connection>
		<developerConnection>scm:git:git@github.com:opaopa6969/unlaxer-parser.git</developerConnection>
		<url>https://github.com/opaopa6969/unlaxer-parser/tree/master/unlaxer-common</url>
	</scm>

	<properties>
		<maven.compiler.release>17</maven.compiler.release>
		<unlaxer.jdk17.shared>${project.basedir}/../unlaxer-common</unlaxer.jdk17.shared>
		<unlaxer.jdk17.skipTests>true</unlaxer.jdk17.skipTests>
	</properties>

	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>net.arnx</groupId>
			<artifactId>jsonic</artifactId>
			<version>1.3.10</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.lsp4j</groupId>
			<artifactId>org.eclipse.lsp4j</artifactId>
			<version>0.21.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<sourceDirectory>${unlaxer.jdk17.shared}/src/main/java</sourceDirectory>
		<testSourceDirectory>${unlaxer.jdk17.shared}/src/test/java</testSourceDirectory>
		<resources>
			<resource>
				<directory>${unlaxer.jdk17.shared}/src/main/resources</directory>
			</resource>
		</resources>
		<testResources>
			<testResource>
				<directory>${unlaxer.jdk17.shared}/src/test/resources</directory>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<release>17</release>
				</configuration>
			</plugin>
			<plugin>
				<!-- The shared tests write reports to target/ relative to their working directory
				     (the shared module), which does not exist when only the -jdk17 modules are built. -->
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>shared-test-output-dir</id>
						<phase>process-test-classes</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<skip>${unlaxer.jdk17.skipTests}</skip>
							<target>
								<mkdir dir="${unlaxer.jdk17.shared}/target"/>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>2.22.1</version>
				<configuration>
					<skip>${unlaxer.jdk17.skipTests}</skip>
					<!-- tests resolve fixtures relative to the shared module directory -->
					<workingDirectory>${unlaxer.jdk17.shared}</workingDirectory>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.0.2</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>2.9.1</version>
				<configuration>
					<show>protected</show>
					<encoding>UTF-8</encoding>
					<charset>UTF-8</charset>
					<docencoding>UTF-8</docencoding>
					<additionalparam>-Xdoclint:none</additionalparam>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>jdk17-tests</id>
			<activation>
				<jdk>[17,18)</jdk>
			</activation>
			<properties>
				<unlaxer.jdk17.skipTests>false</unlaxer.jdk17.skipTests>
			</properties>
		</profile>
	</profiles>
</project>
