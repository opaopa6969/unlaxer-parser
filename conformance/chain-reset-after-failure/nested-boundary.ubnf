grammar NestedBoundary {
    @package: nestedboundary
    @whitespace: none
    token N = NumberParser
    token B = LOOKAHEAD('b')
    token U = UNTIL('b')
    @root @nestedCaptures @mapping(TextNode)
    Root ::= ('a' 'z' | 'q') | N;
    @nestedCaptures @mapping(IntegerNode)
    Integer ::= (N | N) | 't';
    Alias ::= Root;
    OptionalRoot ::= [Root];
    RepeatRoot ::= {Root};
    IntegerAlias ::= Integer;
    IntegerOptional ::= [Integer];
    IntegerRepeat ::= {Integer};
    @nestedCaptures @mapping(SingleNode)
    Single ::= (('a' 'z' | 'q') | N);
    @nestedCaptures @mapping(SingleIntegerNode)
    SingleInteger ::= ((N | N) | 't');
    @nestedCaptures @mapping(AheadNode)
    Ahead ::= (B | 'q') | N;
    @nestedCaptures @mapping(AheadTokenNode)
    AheadToken ::= B | N;
    @nestedCaptures @mapping(LongestNode) @longestChoice
    Longest ::= ('a' 'z' | 'q') | N;
    @nestedCaptures @mapping(UniqueNode) @uniqueLongestChoice
    Unique ::= ('a' 'z' | 'q') | N;
    @nestedCaptures @mapping(PredictiveNode) @predictiveChoice
    Predictive ::= ('a' 'z' | 'q') | N;
    Helper ::= 'a' 'z' | 'h';
    Mix ::= (Helper | 'q') | N;
    Outer ::= Mix | Helper 'x';
    Helper2 ::= 'a' 'z' | 'h';
    Outer2 ::= Helper2 'x' | Helper2 'y' | Helper2;
    OptHelper ::= [Helper] 'x' | Helper;
    @longestChoice
    LongestHelper ::= Helper 'x' | Helper | 'a';
    @uniqueLongestChoice
    UniqueHelper ::= Helper 'x' | Helper;
    OuterOuter ::= Outer 'y' | Outer | Mix 'x';
    PlainSeq2 ::= 'a' 'z';
    TailSeq ::= ('a' | 'h') 'z';
    LiteralOnly ::= 'az';
    UnicodeSeq ::= 'a' '😀';
    UnicodeTail ::= ('a' | 'h') '😀';
    UnicodeLiteral ::= 'a😀';
    LastChoice ::= 'a' ('z' | 'q');
    UntilOnly ::= U;
    UntilChoice ::= U | 'q';
    UntilTail ::= U 'b';
    OptionalTail ::= ['q'] 'a' 'z';
    FailedFirst ::= 'a' 'b' | 'a' 'z' 'z';
    RepeatedA ::= { 'a' };
    PlainAlias ::= PlainSeq2;
    NestedTail ::= LiteralOnly 'z';
}
