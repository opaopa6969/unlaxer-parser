grammar Adapter {
  @tokenAdapter: { id: 'example.word' version: '1' java: 'example.WordParser' rust: 'crate::word_token' }
  token WORD = ADAPTER('example.word', version=1)
  token STRING = ADAPTER('tinyexpression.string', version=0001)
  @root @mapping(Value, params=[value])
  Root ::= WORD @value | STRING @value;
}
