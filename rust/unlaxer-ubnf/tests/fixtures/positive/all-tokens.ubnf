grammar Tokens {
  @import json from 'json.ubnf'
  @ubnf: v2
  @package: org.example.tokens
  @comment: { line: '//' blockOpen: '/*' blockClose: '*/' }
  token N = org.unlaxer.parser.elementary.NumberParser
  token U = UNTIL('*/')
  token X = NEGATION('😀\n\t')
  token L = LOOKAHEAD(':')
  token NL = NEGATIVE_LOOKAHEAD('//')
  token A = ANY
  token E = EOF
  token Z = EMPTY
  token R = CHAR_RANGE('a','z')
  token C = CI('select')
  token RE ::= CHAR_RANGE('0','9')+ '.' CHAR_RANGE('0','9')+;
  @root Root ::= json.Value N U X L NL A E Z R C RE;
}
grammar Second { Rule ::= '😀\n\t\r\'\\\q'; }
