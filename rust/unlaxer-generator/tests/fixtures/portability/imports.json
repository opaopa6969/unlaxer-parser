    "name": "nested-imports-root-and-null-dedup",
    "files": {
      "main.ubnf": "// 😀 root CP positions\ngrammar First {\n  @import nested from 'parts/nested.ubnf'\n  @ubnf: v2\n  @tokenStream: enabled\n  token ImportedLexical0 ::= '';\n  @root @mapping(Value,params=[text]) Root ::= (ImportedLexical0 | nested.Empty) @text;\n}\ngrammar Second {\n  @import nested from 'parts/nested.ubnf'\n  @ubnf: v2\n  @tokenStream: enabled\n  @root @mapping(Value,params=[text]) Root ::= nested.Empty @text;\n}\ngrammar Third {\n  @import nested from 'parts/nested.ubnf'\n  @ubnf: v2\n  @tokenStream: enabled\n  @root @mapping(Value,params=[text]) Root ::= nested.Empty @text;\n}\n",
      "parts/nested.ubnf": "grammar Nested { @import leaf from 'leaf.ubnf' @ubnf: v2 token Empty ::= leaf.Empty; }\n",
      "parts/leaf.ubnf": "// 😀 imported offsets are not root offsets\ngrammar Leaf { @ubnf: v2 token Empty ::= ''; }\n"
