{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tutorial ordered words snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "words"
  ],
  "properties": {
    "schema": {
      "const": "ubnf.words/v1"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "words": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
