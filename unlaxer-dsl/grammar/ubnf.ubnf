// UBNF (Unlaxer BNF) 文法定義（自己ホスティング用）
// Phase 1: 完全文法（全構文サポート）
//
// この .ubnf ファイル自体が UBNF 記法で記述されている。
// Self-hosting: このファイルを unlaxer-dsl 自身で処理して
// UBNFParsers.java 等を生成する。
//
// ルール宣言は ';' で終端する（ルール境界の曖昧さを排除するため）。

grammar UBNF {

  // ===== グローバル設定 =====
  // 生成物は org.unlaxer.dsl.bootstrap.generated に出る (= ubnf-vscode の
  // mainClass / unlaxer-dsl の SelfHostingTest が参照するパッケージ)。
  // 完全 self-hosting (手書き 3 ファイルを生成版で完全置換) は別 Issue で扱う —
  // grammar/experimental/README.md 参照。
  @package: org.unlaxer.dsl.bootstrap.generated
  @whitespace: javaStyle
  @comment: { line: '//' }

  // ===== トークン定義 =====
  // 完全修飾名で書く: GrammarValidator が静的に解決可能 (W-TOKEN-UNRESOLVED 警告ゼロ)
  token IDENTIFIER        = org.unlaxer.parser.clang.IdentifierParser
  token STRING            = org.unlaxer.parser.elementary.SingleQuotedParser
  token CLASS_NAME        = org.unlaxer.parser.clang.IdentifierParser
  token UNSIGNED_INTEGER  = org.unlaxer.parser.elementary.NumberParser
  token DIGIT             = org.unlaxer.parser.posix.DigitParser

  // ===== エントリーポイント =====
  @root
  @mapping(UBNFFile, params=[grammars])
  UBNFFile ::= { GrammarDecl } @grammars ;

  // ===== import 宣言 =====
  // @import alias from 'path' — 別ファイルの文法をインポートする
  @mapping(ImportDecl, params=[alias, path])
  ImportDecl ::= '@import' IDENTIFIER @alias 'from' STRING @path ;

  // ===== grammar ブロック =====
  @mapping(GrammarDecl, params=[name, imports, settings, tokens, rules])
  GrammarDecl ::=
    'grammar' IDENTIFIER @name
    '{'
      { ImportDecl }    @imports
      { GlobalSetting } @settings
      { TokenDecl }     @tokens
      { RuleDecl }      @rules
    '}' ;

  // ===== グローバル設定 =====
  @mapping(GlobalSetting, params=[key, value])
  GlobalSetting ::= '@' IDENTIFIER @key ':' SettingValue @value ;

  SettingValue ::=
      StringSettingValue
    | BlockSettingValue ;

  @mapping(StringSettingValue, params=[value])
  StringSettingValue ::= DottedIdentifier @value ;

  @mapping(BlockSettingValue, params=[entries])
  BlockSettingValue ::= '{' { KeyValuePair } @entries '}' ;

  @mapping(KeyValuePair, params=[key, value])
  KeyValuePair ::= IDENTIFIER @key ':' STRING @value ;

  // ===== トークン宣言 =====
  // token NAME = VALUE （VALUE はクラス名または式）
  @mapping(TokenDecl, params=[name, value])
  TokenDecl ::= 'token' IDENTIFIER @name '=' TokenValue @value ;

  // トークン値: 式またはクラス名
  TokenValue ::=
      UntilExpression
    | NegationExpression
    | LookaheadExpression
    | NegativeLookaheadExpression
    | CharRangeExpression
    | CIExpression
    | RegexExpression
    | AnyExpression
    | EofExpression
    | EmptyExpression
    | DottedIdentifier ;

  // UNTIL('terminator')
  @mapping(UntilExpression, params=[terminator])
  UntilExpression ::= 'UNTIL' '(' STRING @terminator ')' ;

  // NEGATION('chars')
  @mapping(NegationExpression, params=[chars])
  NegationExpression ::= 'NEGATION' '(' STRING @chars ')' ;

  // LOOKAHEAD('pattern')
  @mapping(LookaheadExpression, params=[pattern])
  LookaheadExpression ::= 'LOOKAHEAD' '(' STRING @pattern ')' ;

  // NEGATIVE_LOOKAHEAD('pattern')
  @mapping(NegativeLookaheadExpression, params=[pattern])
  NegativeLookaheadExpression ::= 'NEGATIVE_LOOKAHEAD' '(' STRING @pattern ')' ;

  // CHAR_RANGE('a','z')
  @mapping(CharRangeExpression, params=[min, max])
  CharRangeExpression ::= 'CHAR_RANGE' '(' STRING @min ',' STRING @max ')' ;

  // CI('keyword')
  @mapping(CIExpression, params=[word])
  CIExpression ::= 'CI' '(' STRING @word ')' ;

  // REGEX('pattern')
  @mapping(RegexExpression, params=[pattern])
  RegexExpression ::= 'REGEX' '(' STRING @pattern ')' ;

  // ANY
  @mapping(AnyExpression)
  AnyExpression ::= 'ANY' ;

  // EOF
  @mapping(EofExpression)
  EofExpression ::= 'EOF' ;

  // EMPTY
  @mapping(EmptyExpression)
  EmptyExpression ::= 'EMPTY' ;

  // ===== ルール宣言 =====
  // @declares: ルール名を定義として登録 → LSP の Go-to-Definition の対象
  @mapping(RuleDecl, params=[annotations, name, body])
  @declares(symbol=name)
  RuleDecl ::=
    { Annotation } @annotations
    IDENTIFIER @name
    '::=' RuleBody @body
    ';' ;

  // ===== アノテーション =====
  Annotation ::=
      RootAnnotation
    | MappingAnnotation
    | EvalAnnotation
    | WhitespaceAnnotation
    | InterleaveAnnotation
    | BackrefAnnotation
    | ScopeTreeAnnotation
    | DeclaresAnnotation
    | CatalogAnnotation
    | LeftAssocAnnotation
    | RightAssocAnnotation
    | PrecedenceAnnotation
    | DocAnnotation
    | RecoveryAnnotation
    | SkipAnnotation
    | SimpleAnnotation ;

  @mapping(RootAnnotation)
  RootAnnotation ::= '@root' ;

  @mapping(MappingAnnotation, params=[className, paramNames])
  MappingAnnotation ::=
    '@mapping' '('
      CLASS_NAME @className
      [ ',' 'params' '=' '[' IDENTIFIER @paramNames { ',' IDENTIFIER @paramNames } ']' ]
    ')' ;

  @mapping(EvalAnnotation, params=[entries])
  EvalAnnotation ::= '@eval' '(' KeyValuePair @entries { ',' KeyValuePair @entries } ')' ;

  @mapping(WhitespaceAnnotation, params=[style])
  WhitespaceAnnotation ::= '@whitespace' [ '(' IDENTIFIER @style ')' ] ;

  @mapping(InterleaveAnnotation, params=[profile])
  InterleaveAnnotation ::= '@interleave' '(' 'profile' '=' IDENTIFIER @profile ')' ;

  @mapping(BackrefAnnotation, params=[name])
  BackrefAnnotation ::= '@backref' '(' 'name' '=' IDENTIFIER @name ')' ;

  @mapping(ScopeTreeAnnotation, params=[mode])
  ScopeTreeAnnotation ::= '@scopeTree' '(' 'mode' '=' IDENTIFIER @mode ')' ;

  @mapping(DeclaresAnnotation, params=[symbol, description])
  DeclaresAnnotation ::= '@declares' '(' 'symbol' '=' IDENTIFIER @symbol [ ',' 'description' '=' STRING @description ] ')' ;

  @mapping(CatalogAnnotation, params=[context])
  CatalogAnnotation ::= '@catalog' '(' 'context' '=' STRING @context ')' ;

  @mapping(LeftAssocAnnotation)
  LeftAssocAnnotation ::= '@leftAssoc' ;

  @mapping(RightAssocAnnotation)
  RightAssocAnnotation ::= '@rightAssoc' ;

  @mapping(PrecedenceAnnotation, params=[level])
  PrecedenceAnnotation ::= '@precedence' '(' 'level' '=' UNSIGNED_INTEGER @level ')' ;

  @mapping(DocAnnotation, params=[text])
  DocAnnotation ::= '@doc' '(' STRING @text ')' ;

  @mapping(RecoveryAnnotation, params=[mode, syncTokens])
  RecoveryAnnotation ::= '@recovery' '(' ( 'sync' '=' STRING @syncTokens | IDENTIFIER @mode ) ')' ;

  @mapping(SkipAnnotation)
  SkipAnnotation ::= '@skip' ;

  @mapping(SimpleAnnotation, params=[name])
  SimpleAnnotation ::= '@' IDENTIFIER @name ;

  // ===== ルール本体 =====
  // 選択: A | B | C
  @mapping(ChoiceBody, params=[alternatives])
  ChoiceBody ::= SequenceBody @alternatives { '|' SequenceBody @alternatives } ;

  // 連接: A B C
  @mapping(SequenceBody, params=[elements])
  SequenceBody ::= { AnnotatedElement } @elements ;

  // 要素（@typeof制約とキャプチャ名付き可、後置量化子付き可）
  @mapping(AnnotatedElement, params=[typeofConstraint, element, captureName])
  AnnotatedElement ::=
      [ TypeofElement @typeofConstraint ]
      AtomicElement @element
      [ PostfixQuantifier ]
      [ SeparatedBy ]
      [ '@' IDENTIFIER @captureName ] ;

  // 後置量化子: + ? *
  PostfixQuantifier ::= '+' | '?' | '*' ;

  // 分離リスト: % Separator
  SeparatedBy ::= '%' AtomicElement ;

  // 有界量化子: {n} {n,m} {n,}
  BoundedQuantifier ::= '{' Digits [ ',' [ Digits ] ] '}' ;

  Digits ::= DIGIT { DIGIT } ;

  // 基本要素
  AtomicElement ::=
      GroupElement
    | OptionalElement
    | RepeatElement
    | BoundedQuantifier
    | ErrorElement
    | TerminalElement
    | RuleRefElement ;

  // ( A B | C )  グループ
  @mapping(GroupElement, params=[body])
  GroupElement ::= '(' RuleBody @body ')' ;

  // [ A ]  省略可能
  @mapping(OptionalElement, params=[body])
  OptionalElement ::= '[' RuleBody @body ']' ;

  // { A }  0回以上の繰り返し
  @mapping(RepeatElement, params=[body])
  RepeatElement ::= '{' RuleBody @body '}' ;

  // ERROR('message')  エラーヒント
  @mapping(ErrorElement, params=[message])
  ErrorElement ::= 'ERROR' '(' STRING @message ')' ;

  // 'keyword'  端末記号
  @mapping(TerminalElement, params=[value])
  TerminalElement ::= STRING @value ;

  // 非終端記号参照
  // @backref: ルール参照 → 定義へのジャンプ (Go-to-Definition)
  // namespace は @import で導入されたエイリアス (例: json.Value → namespace=json, name=Value)
  @mapping(RuleRefElement, params=[namespace, name])
  @backref(name=name)
  RuleRefElement ::= [ IDENTIFIER @namespace '.' ] IDENTIFIER @name ;

  // @typeof(captureName) — 要素レベルの型相関アノテーション
  @mapping(TypeofElement, params=[captureName])
  TypeofElement ::= '@typeof' '(' IDENTIFIER @captureName ')' ;

  // ドット区切り識別子（パッケージ名・クラス名）
  @mapping(DottedIdentifier, params=[parts])
  DottedIdentifier ::= IDENTIFIER @parts { '.' IDENTIFIER @parts } ;

  // ルール本体エントリーポイント（ChoiceBody に委譲）
  RuleBody ::= ChoiceBody ;

}
