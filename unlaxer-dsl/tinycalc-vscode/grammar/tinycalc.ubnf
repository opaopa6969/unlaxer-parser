grammar TinyCalc {
  @package: org.unlaxer.tinycalc.generated
  @whitespace: javaStyle

  token NUMBER     = org.unlaxer.parser.elementary.NumberParser
  token IDENTIFIER = org.unlaxer.parser.clang.IdentifierParser

  @root
  @mapping(TinyCalcProgram, params=[declarations, expression])
  TinyCalc ::=
    { VariableDeclaration } @declarations
    Expression @expression ;

  @mapping(VarDecl, params=[keyword, name, init])
  VariableDeclaration ::=
    ( 'var' | 'variable' ) @keyword
    IDENTIFIER @name
    [ 'set' Expression @init ]
    ';' ;

  @mapping(BinaryExpr, params=[left, op, right])
  @leftAssoc
  @precedence(level=10)
  Expression ::= Term @left { AddOp @op Term @right } ;

  @mapping(BinaryExpr, params=[left, op, right])
  @leftAssoc
  @precedence(level=20)
  Term ::= Factor @left { MulOp @op Factor @right } ;

  AddOp ::= '+' | '-' ;
  MulOp ::= '*' | '/' ;

  Factor ::=
      '(' Expression ')'
    | NUMBER
    | IDENTIFIER ;
}
