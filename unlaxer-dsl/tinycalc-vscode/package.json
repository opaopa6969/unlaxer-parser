{
  "name": "tinycalc-lsp",
  "displayName": "TinyCalc DSL (LSP)",
  "description": "VS Code extension for the TinyCalc DSL backed by a Java or Rust LSP server generated by unlaxer-dsl.",
  "version": "0.1.0",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.97.2"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:tinycalc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tinycalcLsp.restartServer",
        "title": "TinyCalc: Restart Language Server"
      }
    ],
    "languages": [
      {
        "id": "tinycalc",
        "aliases": [
          "TinyCalc",
          "tinycalc"
        ],
        "extensions": [
          ".tcalc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tinycalc",
        "scopeName": "source.tinycalc",
        "path": "./syntaxes/tinycalc.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "tinycalc",
        "label": "TinyCalc Debug",
        "languages": [
          "tinycalc"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .tcalc file for AST or token inspection.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause before structural inspection (does not suspend a live evaluator).",
                "default": true
              },
              "steppingMode": {
                "type": "string",
                "enum": [
                  "ast",
                  "token"
                ],
                "description": "Structural stepping model.",
                "default": "ast"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tinycalc",
            "request": "launch",
            "name": "Debug TinyCalc File",
            "program": "${file}",
            "stopOnEntry": true,
            "steppingMode": "ast"
          }
        ],
        "configurationSnippets": [
          {
            "label": "TinyCalc: Launch",
            "description": "Parse and validate a TinyCalc file.",
            "body": {
              "type": "tinycalc",
              "request": "launch",
              "name": "${1:Debug TinyCalc File}",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "TinyCalc LSP",
      "properties": {
        "tinycalcLsp.server.startupTimeoutMs": {"type": "integer", "minimum": 1000, "maximum": 300000, "default": 30000, "description": "Maximum milliseconds to wait for language server initialization."},
        "tinycalcLsp.server.backend": {
          "type": "string",
          "enum": [
            "java",
            "rust"
          ],
          "default": "java",
          "description": "Server implementation. Changing server settings restarts the language server; new debug sessions use the selected backend."
        },
        "tinycalcLsp.server.rustLspPath": {
          "type": "string",
          "default": "",
          "description": "Path or executable name of the generated Rust LSP stdio server. Required when using Rust; no shell expansion."
        },
        "tinycalcLsp.server.rustLspArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed directly to the Rust LSP server."
        },
        "tinycalcLsp.server.rustDapPath": {
          "type": "string",
          "default": "",
          "description": "Path or executable name of the generated Rust DAP stdio server. Required when using Rust; no shell expansion."
        },
        "tinycalcLsp.server.rustDapArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed directly to the Rust DAP server."
        },
        "tinycalcLsp.server.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Java executable to launch the language server."
        },
        "tinycalcLsp.server.jarPath": {
          "type": "string",
          "default": "",
          "description": "Path to the TinyCalc LSP server jar. If empty, the bundled jar is used."
        },
        "tinycalcLsp.server.jvmArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra JVM arguments (e.g. -Xmx256m)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:rust": "node scripts/build-rust.mjs",
    "test:vsix": "node scripts/vsix-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "^2.26.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
