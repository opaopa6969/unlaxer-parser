{
  "UBNF grammar skeleton": {
    "prefix": "grammar",
    "body": [
      "grammar ${1:Name} {",
      "  @ubnf: v2",
      "  @package: ${2:org.example}",
      "",
      "  token ${3:NUMBER} ::= CHAR_RANGE('0', '9')+;",
      "  token ${4:IDENTIFIER} ::= (CHAR_RANGE('a', 'z') | '_')+;",
      "",
      "  @root",
      "  @mapping(Value, params=[text])",
      "  @doc('数字を入力してください。')",
      "  ${5:Start} ::= ${3:NUMBER} @text;",
      "}"
    ],
    "description": "Playground-ready grammar with declarative tokens, @root, @mapping and @doc"
  },
  "Mapped rule": {
    "prefix": "mapped-rule",
    "body": [
      "@mapping(${1:TypeName}, params=[${2:left}, ${3:right}])",
      "${4:RuleName} ::= ${5:Element} @${2:left} ${6:Element} @${3:right} ;"
    ],
    "description": "Rule with @mapping record generation"
  },
  "Left-assoc binary rule": {
    "prefix": "binary-rule",
    "body": [
      "@mapping(${1:BinaryExpr}, params=[left, op, right])",
      "@leftAssoc",
      "${2:Expression} ::= ${3:Term} @left { ${4:Op} @op ${3:Term} @right } ;"
    ],
    "description": "Left-associative binary expression rule"
  },
  "Enum rule": {
    "prefix": "enum-rule",
    "body": [
      "@enum",
      "${1:Kind} ::= '${2:a}' | '${3:b}' ;"
    ],
    "description": "@enum rule generating a Java enum"
  },
  "Token declaration": {
    "prefix": "token",
    "body": ["token ${1:NAME} ::= ${2:CHAR_RANGE('0', '9')+};"],
    "description": "Declarative token: generate recognition from the grammar"
  },
  "UNTIL token": {
    "prefix": "until",
    "body": ["token ${1:BODY} ::= { NEGATIVE_LOOKAHEAD('${2:end}') ANY };"],
    "description": "Declarative token matching up to a terminator (does not consume it)"
  },
  "Grammar import": {
    "prefix": "import",
    "body": ["@import ${1:alias} from '${2:path/to/base.ubnf}'"],
    "description": "Import declarative tokens; place before settings and refer to alias.TOKEN"
  },
  "Scope rule": {
    "prefix": "scope-rule",
    "body": [
      "@scopeTree(mode=${1:lexical})",
      "${2:Block} ::= '{' { ${3:Statement} } '}' ;"
    ],
    "description": "Scope boundary rule for @declares/@backref"
  }
}
