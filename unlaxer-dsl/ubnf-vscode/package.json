{
  "name": "ubnf-lsp",
  "displayName": "UBNF (LSP)",
  "description": "Rich VS Code extension for UBNF grammar files: live GrammarValidator diagnostics with quick fixes, navigation, rename, outline, snippets and semantic highlighting — backed by a Java LSP server generated by unlaxer-dsl.",
  "version": "0.3.0",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:ubnf",
    "onCommand:ubnfLsp.showServerOutput",
    "onCommand:ubnfLsp.openHelp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ubnf",
        "aliases": [
          "UBNF",
          "ubnf"
        ],
        "extensions": [
          ".ubnf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ubnf",
        "scopeName": "source.ubnf",
        "path": "./syntaxes/ubnf.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "UBNF LSP",
      "properties": {
        "ubnfLsp.server.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Java executable to launch the language server."
        },
        "ubnfLsp.server.jarPath": {
          "type": "string",
          "default": "",
          "description": "Path to the UBNF LSP server jar. If empty, the bundled jar is used."
        },
        "ubnfLsp.server.jvmArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra JVM arguments (e.g. -Xmx256m)."
        }
      }
    },
    "snippets": [
      {
        "language": "ubnf",
        "path": "./snippets/ubnf.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "ubnfLsp.openHelp",
        "title": "UBNF: はじめの一歩 / Catalog・Help",
        "icon": "$(book)"
      },
      {
        "command": "ubnfLsp.showServerOutput",
        "title": "UBNF: Show Language Server Output"
      }
    ],
    "menus": {
      "editor/title": [
        {"command": "ubnfLsp.openHelp", "when": "resourceLangId == ubnf", "group": "navigation"}
      ]
    },
    "walkthroughs": [{
      "id": "ubnfGettingStarted",
      "title": "UBNF で最初の文法を書く",
      "description": "単語から始めて、数値・名前・文字列を受け入れる言語へ。画面内の例をそのまま使えます。",
      "steps": [{
        "id": "openCatalog",
        "title": "文法の書き方を学ぶ",
        "description": "[はじめの一歩を開く](command:ubnfLsp.openHelp)\nサンプルを新規文書で開いて .ubnf として保存します。",
        "media": {"markdown": "help-welcome.md"},
        "completionEvents": ["onCommand:ubnfLsp.openHelp"]
      }]
    }],
    "semanticTokenScopes": [
      {
        "language": "ubnf",
        "scopes": {
          "keyword": [
            "keyword.control.ubnf"
          ],
          "type": [
            "entity.name.type.rule-ref.ubnf"
          ],
          "property": [
            "constant.other.token.ubnf"
          ],
          "macro": [
            "storage.modifier.annotation.ubnf"
          ],
          "string": [
            "string.quoted.single.ubnf"
          ],
          "number": [
            "constant.numeric.ubnf"
          ],
          "operator": [
            "keyword.operator.ubnf"
          ],
          "comment": [
            "comment.line.double-slash.ubnf"
          ],
          "function": [
            "support.function.token-type.ubnf"
          ],
          "namespace": [
            "entity.name.namespace.fqn.ubnf"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node scripts/prepare-help.mjs && tsc -p ./",
    "test:help": "npm run compile && node --test scripts/help.test.mjs && node scripts/help-browser.mjs",
    "test:vsix": "node scripts/vsix-smoke.mjs",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.5.2",
    "playwright": "1.63.0",
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5",
    "@vscode/vsce": "^2.26.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opaopa6969/unlaxer-parser.git",
    "directory": "unlaxer-dsl/ubnf-vscode"
  },
  "license": "MIT"
}
