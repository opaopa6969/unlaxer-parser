      {"id":"compact", "input":"ab", "prefix":[true,2,2], "accepted":true,
       "ast":{"type":"Root","span":[0,2],"fields":{"value":"a"}}},
      {"id":"does-not-enable-space", "input":"a b", "prefix":[false,0,0], "accepted":false},
