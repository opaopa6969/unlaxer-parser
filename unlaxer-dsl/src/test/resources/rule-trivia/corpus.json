  {
    "name": "global-omitted",
    "grammar": "grammar GlobalOmitted { @package: org.example.ruletrivia @root @mapping(Root, params=[value]) Root ::= 'a' @value 'b'; }",
    "cases": [
      {"id":"compact", "input":"ab", "prefix":[true,2,2], "accepted":true,
       "ast":{"type":"Root","span":[0,2],"fields":{"value":"a"}}},
      {"id":"space-is-significant", "input":"a b", "prefix":[false,0,0], "accepted":false},
      {"id":"valid-prefix", "input":"ab!", "prefix":[true,2,2], "accepted":false}
    ]
  },
  {
