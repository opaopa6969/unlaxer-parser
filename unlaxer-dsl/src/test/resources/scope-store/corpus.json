  {
    "name": "global-preexisting-empty-and-redeclare",
    "source": "",
    "runs": [{
      "id": "main",
      "operations": [
        {"op":"leave"},
        {"op":"declare","name":"global","offset":0},
        {"op":"declare","name":"dup","offset":1},
        {"op":"declare","name":"dup","offset":2},
        {"op":"declare","name":"","offset":99},
        {"op":"addReference","name":"","offset":99,"length":1},
        {"op":"retainCurrent","slot":"global-before-enter"},
        {"op":"observe","id":"global","names":["","dup","global","missing"],
         "expected":{"depth":0,"cursor":[0,0],
           "resolved":[
             {"query":"","declared":false,"symbol":null},
             {"query":"dup","declared":true,"symbol":{"name":"dup","sourceOffset":2}},
             {"query":"global","declared":true,"symbol":{"name":"global","sourceOffset":0}},
             {"query":"missing","declared":false,"symbol":null}],
           "declaredCurrent":[{"name":"dup","sourceOffset":2},{"name":"global","sourceOffset":0}],
           "allDeclarations":[{"name":"global","sourceOffset":0},{"name":"dup","sourceOffset":1},{"name":"dup","sourceOffset":2}],
           "references":[],"diagnostics":[],
           "retained":{"global-before-enter":[{"name":"dup","sourceOffset":2},{"name":"global","sourceOffset":0}]}}},
        {"op":"enter"},
        {"op":"declare","name":"inner","offset":3},
        {"op":"observe","id":"inner","names":["dup","global","inner"],
         "expected":{"depth":1,"cursor":[0,0],
           "resolved":[
             {"query":"dup","declared":true,"symbol":{"name":"dup","sourceOffset":2}},
             {"query":"global","declared":true,"symbol":{"name":"global","sourceOffset":0}},
             {"query":"inner","declared":true,"symbol":{"name":"inner","sourceOffset":3}}],
           "declaredCurrent":[{"name":"inner","sourceOffset":3}],
           "allDeclarations":[{"name":"global","sourceOffset":0},{"name":"dup","sourceOffset":1},{"name":"dup","sourceOffset":2},{"name":"inner","sourceOffset":3}],
           "references":[],"diagnostics":[],
           "retained":{"global-before-enter":[{"name":"dup","sourceOffset":2},{"name":"global","sourceOffset":0}]}}},
        {"op":"leave"}
      ]
    }]
  },
  {
    "name": "shadow-leave-and-owned-snapshot",
    "source": "",
    "runs": [{
      "id": "main",
      "operations": [
        {"op":"declare","name":"x","offset":0},
        {"op":"enter"},
        {"op":"declare","name":"x","offset":5},
        {"op":"declare","name":"y","offset":6},
        {"op":"retainCurrent","slot":"inner"},
        {"op":"observe","id":"shadowed","names":["x","y"],
         "expected":{"depth":1,"cursor":[0,0],
           "resolved":[
             {"query":"x","declared":true,"symbol":{"name":"x","sourceOffset":5}},
             {"query":"y","declared":true,"symbol":{"name":"y","sourceOffset":6}}],
           "declaredCurrent":[{"name":"x","sourceOffset":5},{"name":"y","sourceOffset":6}],
           "allDeclarations":[{"name":"x","sourceOffset":0},{"name":"x","sourceOffset":5},{"name":"y","sourceOffset":6}],
           "references":[],"diagnostics":[],
           "retained":{"inner":[{"name":"x","sourceOffset":5},{"name":"y","sourceOffset":6}]}}},
        {"op":"leave"},
        {"op":"declare","name":"z","offset":7},
        {"op":"observe","id":"after-leave","names":["x","y","z"],
         "expected":{"depth":0,"cursor":[0,0],
           "resolved":[
             {"query":"x","declared":true,"symbol":{"name":"x","sourceOffset":0}},
             {"query":"y","declared":false,"symbol":null},
             {"query":"z","declared":true,"symbol":{"name":"z","sourceOffset":7}}],
           "declaredCurrent":[{"name":"x","sourceOffset":0},{"name":"z","sourceOffset":7}],
           "allDeclarations":[{"name":"x","sourceOffset":0},{"name":"x","sourceOffset":5},{"name":"y","sourceOffset":6},{"name":"z","sourceOffset":7}],
           "references":[],"diagnostics":[],
           "retained":{"inner":[{"name":"x","sourceOffset":5},{"name":"y","sourceOffset":6}]}}}
      ]
    }]
