  {
    "name": "inner-commit-outer-rollback",
    "source": "abcdef",
    "runs": [{
      "id": "main",
      "operations": [
        {"op":"declare","name":"stable","offset":0},
        {"op":"addReference","name":"stable","offset":0,"length":1},
        {"op":"addDiagnostic","message":"baseline","offset":0,"length":1,"severity":"INFO"},
        {"op":"transaction","result":"rollback","operations":[
          {"op":"advance","points":1},
          {"op":"enter"},
          {"op":"declare","name":"outer","offset":1},
          {"op":"addReference","name":"outer","offset":1,"length":1},
          {"op":"addDiagnostic","message":"outer warning","offset":1,"length":1,"severity":"WARNING"},
          {"op":"transaction","result":"commit","operations":[
            {"op":"advance","points":2},
            {"op":"enter"},
            {"op":"declare","name":"stable","offset":3},
            {"op":"declare","name":"inner","offset":3},
            {"op":"addReference","name":"inner","offset":3,"length":1},
            {"op":"addDiagnostic","message":"inner error","offset":3,"length":1,"severity":"ERROR"},
            {"op":"observe","id":"inside-inner","names":["inner","outer","stable"],
             "expected":{"depth":2,"cursor":[3,3],
               "resolved":[
                 {"query":"inner","declared":true,"symbol":{"name":"inner","sourceOffset":3}},
                 {"query":"outer","declared":true,"symbol":{"name":"outer","sourceOffset":1}},
                 {"query":"stable","declared":true,"symbol":{"name":"stable","sourceOffset":3}}],
               "declaredCurrent":[{"name":"inner","sourceOffset":3},{"name":"stable","sourceOffset":3}],
               "allDeclarations":[{"name":"stable","sourceOffset":0},{"name":"outer","sourceOffset":1},{"name":"stable","sourceOffset":3},{"name":"inner","sourceOffset":3}],
               "references":[{"name":"stable","offset":0,"length":1},{"name":"outer","offset":1,"length":1},{"name":"inner","offset":3,"length":1}],
               "diagnostics":[
                 {"message":"baseline","offset":0,"length":1,"severity":"INFO"},
                 {"message":"outer warning","offset":1,"length":1,"severity":"WARNING"},
                 {"message":"inner error","offset":3,"length":1,"severity":"ERROR"}],
               "retained":{}}}
          ]},
          {"op":"observe","id":"inner-committed-to-parent","names":["inner","outer","stable"],
           "expected":{"depth":2,"cursor":[3,3],
             "resolved":[
               {"query":"inner","declared":true,"symbol":{"name":"inner","sourceOffset":3}},
               {"query":"outer","declared":true,"symbol":{"name":"outer","sourceOffset":1}},
               {"query":"stable","declared":true,"symbol":{"name":"stable","sourceOffset":3}}],
             "declaredCurrent":[{"name":"inner","sourceOffset":3},{"name":"stable","sourceOffset":3}],
             "allDeclarations":[{"name":"stable","sourceOffset":0},{"name":"outer","sourceOffset":1},{"name":"stable","sourceOffset":3},{"name":"inner","sourceOffset":3}],
             "references":[{"name":"stable","offset":0,"length":1},{"name":"outer","offset":1,"length":1},{"name":"inner","offset":3,"length":1}],
             "diagnostics":[
               {"message":"baseline","offset":0,"length":1,"severity":"INFO"},
               {"message":"outer warning","offset":1,"length":1,"severity":"WARNING"},
               {"message":"inner error","offset":3,"length":1,"severity":"ERROR"}],
             "retained":{}}},
          {"op":"leave"}
        ]},
        {"op":"observe","id":"outer-rolled-back","names":["inner","outer","stable"],
         "expected":{"depth":0,"cursor":[0,0],
           "resolved":[
             {"query":"inner","declared":false,"symbol":null},
             {"query":"outer","declared":false,"symbol":null},
             {"query":"stable","declared":true,"symbol":{"name":"stable","sourceOffset":0}}],
           "declaredCurrent":[{"name":"stable","sourceOffset":0}],
           "allDeclarations":[{"name":"stable","sourceOffset":0}],
           "references":[{"name":"stable","offset":0,"length":1}],
           "diagnostics":[{"message":"baseline","offset":0,"length":1,"severity":"INFO"}],
           "retained":{}}}
      ]
    }]
  },
