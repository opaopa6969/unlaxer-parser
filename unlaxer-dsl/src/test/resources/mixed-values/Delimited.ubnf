grammar Mixed {
  @package: org.example.mixed
  @whitespace: javaStyle
  token STRING = SingleQuotedParser
  @root @mapping(Root, params=[head, maybe, items])
  Document ::= Outer @head ':' [ Outer @maybe ] ':' { Outer @items };
  Outer ::= '(' Factor ')';
  Factor ::= 'a' | '😀' | STRING | LeafRule | OtherRule;
  @mapping(Leaf, params=[value]) LeafRule ::= 'x' @value;
  @mapping(OtherLeaf, params=[value]) OtherRule ::= 'y' @value;
}
