// @mapping / @leftAssoc / @precedence annotations for AST generation.

grammar {{ClassName}} {
  @package: {{packageName}}
  @whitespace: javaStyle

  token NUMBER     = NumberParser
  token IDENTIFIER = IdentifierParser

  @root
  Program ::= { Statement } ;

  Statement ::=
      Assignment
    | Expression ';' ;

  Assignment ::=
    ( 'var' | 'let' ) IDENTIFIER '=' Expression ';' ;

  Expression ::= Term { ( '+' | '-' ) Term } ;
  Term       ::= Factor { ( '*' | '/' ) Factor } ;
  Factor     ::=
      '(' Expression ')'
    | NUMBER
    | IDENTIFIER ;
}
