// {{ClassName}} — sample grammar with @mapping (required for AST/Mapper/DAP).
// Generated by `unlaxer init --with-dap`.
//
// See: ../IMPLEMENTATION.md for the development workflow.

grammar {{ClassName}} {
  @package: {{packageName}}
  @whitespace: javaStyle

  token NUMBER     = NumberParser
  token IDENTIFIER = IdentifierParser

  @root
  @mapping({{ClassName}}Program, params=[statements])
  Program ::= { Statement } @statements ;

  @mapping(VarDecl, params=[keyword, name, value])
  Statement ::=
    ( 'var' | 'let' ) @keyword
    IDENTIFIER @name
    '=' Expression @value
    ';' ;

  Expression ::= Term { ( '+' | '-' ) Term } ;
  Term       ::= Factor { ( '*' | '/' ) Factor } ;
  Factor     ::=
      '(' Expression ')'
    | NUMBER
    | IDENTIFIER ;
}
