import * as path from "path";
import { ChildProcess, spawn } from "node:child_process";
import * as vscode from "vscode";
import { LanguageClient, LanguageClientOptions, ServerOptions, CloseAction, ErrorAction } from "vscode-languageclient/node";

let client: OwnedLanguageClient | undefined;
let pending: Promise<void> = Promise.resolve();
let stopping = false;
let ownedProcess: ChildProcess | undefined;
let cancelStarting: (() => void) | undefined;
// One bounded budget for the LSP shutdown exchange and natural process exit.
const shutdownTimeoutMs = 5000;
class StartupCancelled extends Error {}

class OwnedLanguageClient extends LanguageClient {
  ready = false;
  override stop(timeout?: number): Promise<void> {
    // languageclient 9 invokes stop without handling its rejection when initialize fails.
    // Its Running state precedes the initialized notification and completion of start().
    // Failed/interrupted initialization must not send shutdown over that broken transport.
    // stopClient terminates our owned process instead.
    if (!this.ready || !this.isRunning()) return Promise.resolve();
    return super.stop(timeout);
  }
}

async function stopClient(): Promise<void> {
  const previous = client;
  client = undefined;
  const deadline = Date.now() + shutdownTimeoutMs;
  let graceful = previous?.ready && previous.isRunning();
  try { if (previous) await previous.dispose(shutdownTimeoutMs); }
  catch { graceful = false; }
  const child = ownedProcess;
  // Protocol completion only means exit was sent, not that the process has exited.
  // Give a healthy server the remaining budget before falling back to signals.
  // Failed/interrupted initialization skips this wait and is terminated immediately.
  if (graceful && child && child.exitCode === null && child.signalCode === null && child.pid !== undefined) {
    await new Promise<void>(resolve => {
      const exited = (): void => { clearTimeout(timer); resolve(); };
      const timer = setTimeout(() => { child.off("exit", exited); resolve(); }, Math.max(0, deadline - Date.now()));
      child.once("exit", exited);
    });
  }
  if (child && child.exitCode === null && child.signalCode === null && child.pid !== undefined) {
    await new Promise<void>((resolve, reject) => {
      const force = setTimeout(() => child.kill("SIGKILL"), 500);
      const deadline = setTimeout(() => { clearTimeout(force); reject(new Error("Server process did not terminate.")); }, 3000);
      child.once("exit", () => { clearTimeout(force); clearTimeout(deadline); resolve(); });
      child.kill("SIGTERM");
    });
  }
  ownedProcess = undefined;
}

type Command = { command: string; args: string[] };

function serverCommand(context: vscode.ExtensionContext, protocol: "lsp" | "dap"): Command {
  const config = vscode.workspace.getConfiguration("{{name}}Lsp");
  function text(key: string, fallback: string): string {
    const value = config.get<unknown>(key, fallback);
    if (typeof value !== "string" || !value.trim()) throw new Error(`{{ClassName}}: ${key} must be a nonempty string.`);
    return value;
  }
  function args(key: string): string[] {
    const value = config.get<unknown>(key, []);
    if (!Array.isArray(value) || value.some(item => typeof item !== "string")) throw new Error(`{{ClassName}}: ${key} must be an array of strings.`);
    return value;
  }
  const backend = text("server.backend", "java");
  if (backend === "rust") {
    return { command: text(protocol === "lsp" ? "server.rustLspPath" : "server.rustDapPath", ""),
      args: args(protocol === "lsp" ? "server.rustLspArgs" : "server.rustDapArgs") };
  }
  if (backend !== "java") throw new Error(`{{ClassName}}: server.backend must be java or rust.`);
  const configuredJar = config.get<unknown>("server.jarPath", "");
  if (typeof configuredJar !== "string") throw new Error("{{ClassName}}: server.jarPath must be a string.");
  const jar = configuredJar.trim() ? configuredJar : context.asAbsolutePath(path.join("server-dist", "{{name}}-lsp-server.jar"));
  const javaArgs = [...args("server.jvmArgs"), "--enable-preview"];
  if (protocol === "lsp") javaArgs.push("-jar", jar);
{{#dap}}  else javaArgs.push("-cp", jar, "{{packageName}}.{{ClassName}}DapLauncher");
{{/dap}}  return { command: text("server.javaPath", "java"), args: javaArgs };
}

export async function activate(context: vscode.ExtensionContext): Promise<void> {
  stopping = false;
  const output = vscode.window.createOutputChannel("{{ClassName}} LSP");
  context.subscriptions.push(output);
  let crashes: number[] = [];
  const restart = (): Promise<void> => {
    cancelStarting?.();
    const operation = pending.then(async () => {
      if (stopping) return;
      // Validate before replacing a working server. Commands and arguments never pass through a shell.
      const command = serverCommand(context, "lsp");
      const timeout = vscode.workspace.getConfiguration("{{name}}Lsp").get<unknown>("server.startupTimeoutMs", 30000);
      if (typeof timeout !== "number" || !Number.isInteger(timeout) || timeout < 1000 || timeout > 300000) {
        throw new Error("server.startupTimeoutMs must be an integer from 1000 to 300000.");
      }
      await stopClient();
      if (stopping) return;
      let cancelled = false;
      const options: ServerOptions = () => new Promise<ChildProcess>((resolve, reject) => {
        if (cancelled || stopping) { reject(new StartupCancelled()); return; }
        const child = spawn(command.command, command.args, { shell: false, stdio: "pipe", windowsHide: true });
        ownedProcess = child;
        child.once("error", reject);
        child.once("spawn", () => resolve(child));
      });
      const clientOptions: LanguageClientOptions = {
        documentSelector: [{ scheme: "file", language: "{{name}}" }], outputChannel: output,
        errorHandler: {
          error: () => ({ action: ErrorAction.Continue }),
          closed: () => {
            if (next.ready && !stopping && client === next) {
              const now = Date.now();
              crashes = crashes.filter(time => now - time < 180000);
              crashes.push(now);
              if (crashes.length <= 5) {
                // Finish the client's close transition before entering our serialized restart queue.
                setTimeout(() => { if (!stopping && client === next) void restart().catch(report); }, 0);
              } else report(new Error("Server exited repeatedly. Correct the configuration and restart manually."));
            }
            return { action: CloseAction.DoNotRestart, handled: true };
          }
        }
      };
      const next = new OwnedLanguageClient("{{name}}LanguageServer", "{{ClassName}} Language Server", options, clientOptions);
      client = next;
      let timer: ReturnType<typeof setTimeout> | undefined;
      const interrupted = new Promise<never>((_, reject) => {
        cancelStarting = () => { cancelled = true; reject(new StartupCancelled()); };
        timer = setTimeout(() => { cancelled = true; reject(new Error(`Server initialization exceeded ${timeout} ms.`)); }, timeout);
      });
      try {
        const started = next.start();
        // Repeated start observes the existing startup promise. Attach its rejection handler
        // now: languageclient 9 otherwise leaves that internal promise unhandled on failure.
        void next.start().catch(() => {});
        await Promise.race([started, interrupted]);
        next.ready = true;
      } catch (error) {
        await stopClient();
        if (!(error instanceof StartupCancelled)) throw error;
      } finally {
        clearTimeout(timer);
        cancelStarting = undefined;
      }
    });
    // A failed start must not poison subsequent explicit restart attempts.
    pending = operation.catch(() => {});
    return operation;
  };
  const report = (error: unknown): void => {
    const message = error instanceof Error ? error.message : String(error);
    output.appendLine(message);
    void vscode.window.showErrorMessage(`{{ClassName}} server: ${message}`);
  };
  context.subscriptions.push(vscode.commands.registerCommand("{{name}}Lsp.restartServer", restart));
  context.subscriptions.push(vscode.workspace.onDidChangeConfiguration(event => {
    if (event.affectsConfiguration("{{name}}Lsp.server")) void restart().catch(report);
  }));
{{#dap}}  context.subscriptions.push(vscode.debug.registerDebugAdapterDescriptorFactory("{{name}}", {
    createDebugAdapterDescriptor(): vscode.DebugAdapterExecutable {
      const command = serverCommand(context, "dap");
      return new vscode.DebugAdapterExecutable(command.command, command.args);
    }
  }));
{{/dap}}  await restart().catch(report);
}

export async function deactivate(): Promise<void> {
  stopping = true;
  cancelStarting?.();
  await pending;
  await stopClient();
}
