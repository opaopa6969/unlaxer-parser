{
  "name": "{{name}}-lsp",
  "displayName": "{{ClassName}} DSL (LSP)",
  "description": "VS Code extension for the {{ClassName}} DSL backed by a Java or Rust LSP server generated by unlaxer-dsl.",
  "version": "0.1.0",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.97.2"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:{{name}}"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [{"command": "{{name}}Lsp.restartServer", "title": "{{ClassName}}: Restart Language Server"}],
    "languages": [
      {
        "id": "{{name}}",
        "aliases": [
          "{{ClassName}}",
          "{{name}}"
        ],
        "extensions": [
          "{{extension}}"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "{{name}}",
        "scopeName": "source.{{name}}",
        "path": "./syntaxes/{{name}}.tmLanguage.json"
      }
    ],
{{#dap}}    "debuggers": [
      {
        "type": "{{name}}",
        "label": "{{ClassName}} Debug",
        "languages": ["{{name}}"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the {{extension}} file to parse and run.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause before structural inspection (does not suspend a live evaluator).",
                "default": true
              },
              "steppingMode": {
                "type": "string",
                "enum": ["ast", "token"],
                "description": "Structural stepping model. Use ast when AST and Mapper are generated.",
                "default": "ast"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "{{name}}",
            "request": "launch",
            "name": "Debug {{ClassName}} File",
            "program": "${file}",
            "stopOnEntry": true,
            "steppingMode": "ast"
          }
        ],
        "configurationSnippets": [
          {
            "label": "{{ClassName}}: Launch",
            "description": "Parse and validate a {{ClassName}} file.",
            "body": {
              "type": "{{name}}",
              "request": "launch",
              "name": "${1:Debug {{ClassName}} File}",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true,
              "steppingMode": "ast"
            }
          }
        ]
      }
    ],
{{/dap}}    "configuration": {
      "title": "{{ClassName}} LSP",
      "properties": {
          "{{name}}Lsp.server.startupTimeoutMs": {"type": "integer", "minimum": 1000, "maximum": 300000, "default": 30000, "description": "Maximum milliseconds to wait for language server initialization."},
        "{{name}}Lsp.server.backend": {
            "type": "string",
            "enum": [
              "java",
              "rust"
            ],
            "default": "java",
            "description": "Server implementation. Changing server settings restarts the language server; new debug sessions use the selected backend."
          },
          "{{name}}Lsp.server.rustLspPath": {
            "type": "string",
            "default": "",
            "description": "Path or executable name of the generated Rust LSP stdio server. Required when using Rust; no shell expansion."
          },
          "{{name}}Lsp.server.rustLspArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Arguments passed directly to the Rust LSP server."
          },
          "{{name}}Lsp.server.rustDapPath": {
            "type": "string",
            "default": "",
            "description": "Path or executable name of the generated Rust DAP stdio server. Required when using Rust; no shell expansion."
          },
          "{{name}}Lsp.server.rustDapArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Arguments passed directly to the Rust DAP server."
          },
        "{{name}}Lsp.server.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Java executable to launch the language server."
        },
        "{{name}}Lsp.server.jarPath": {
          "type": "string",
          "default": "",
          "description": "Path to the {{ClassName}} LSP server jar. If empty, the bundled jar is used."
        },
        "{{name}}Lsp.server.jvmArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra JVM arguments (e.g. -Xmx256m)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5",
    "@vscode/vsce": "^2.26.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
