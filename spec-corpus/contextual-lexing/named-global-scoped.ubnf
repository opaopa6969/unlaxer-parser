grammar Input {
 @ubnf: v2
 @package: example.lexing
 @tokenStream: enabled
 @whitespace: GAP
 token GAP ::= '#'+;
 token ID ::= 'a' | '😀';
 token END = EOF
 @root @mapping(Value, params=[value])
 @lexicalContext(tokens=['ID'], literals=['ok','retry','flip','raw','nested','!','(',')'])
 Root ::= 'ok' Local @value '!' END
        | 'retry' (Wrong | Local) @value '!' END
        | 'flip' (InheritedWrong | Local) @value '!' END
        | 'raw' Raw @value '!' END
        | 'nested' Outer @value '!' END;
 @whitespace(javaStyle) @lexicalContext(tokens=['ID'], literals=['(',')'])
 Local ::= '(' ID ')';
 @whitespace(javaStyle) @lexicalContext(tokens=['ID'], literals=['(',')','?'])
 Wrong ::= '(' ID ')' '?';
 @lexicalContext(tokens=['ID'], literals=['(',')','?'])
 InheritedWrong ::= '(' ID ')' '?';
 @whitespace(none)
 Raw ::= '(' ID ')';
 @whitespace(javaStyle)
 Outer ::= '(' Raw ')';
}
