grammar LexicalProbe {
  @ubnf: v2
  @feature: declarativeTokensV1
  @feature: contextAccessorsV1
  @package: lexical.probe
  token SCALAR_RANGE = CHAR_RANGE('\u{1F600}','\u{1F601}')
  token BMP_ESCAPE = CHAR_RANGE('\u0041','\u0042')
  token SAFE_SCALAR = NEGATION('\u0000\u0009\u000A\u{1F600}')
  token ESCAPED_BACKSLASH = NEGATION('\\u0041')
  token RAW_ESCAPE ::= '\u0041';
  token DIGIT ::= CHAR_RANGE('0','9');
  token NUMBER ::= ['+'|'-'] (DIGIT+ '.' DIGIT* | '.' DIGIT+ | DIGIT+)
    [('e'|'E') ['+'|'-'] DIGIT+];
  token LETTER ::= CHAR_RANGE('a','z') | CHAR_RANGE('A','Z') | '_';
  token IDENTIFIER ::= LETTER (LETTER | DIGIT)*;
  token STRING ::= '"' { '\\' ANY | NEGATION('"\\') } '"'
    | '\'' { '\\' ANY | NEGATION('\'\\') } '\'';
  token NL ::= '\r\n' | '\r' | '\n';
  token CLASS_NAME ::= IDENTIFIER ('.' IDENTIFIER)*;
  token BLOCK ::= BOL CAPTURE(fence, '`'{4,}) IDENTIFIER ':' CLASS_NAME NL
    { NEGATIVE_LOOKAHEAD(BOL SAME_AS(fence) EOL) ANY }
    BOL SAME_AS(fence) (NL | EOF);
  token CHILD ::= CAPTURE(x,'b') SAME_AS(x);
  token ROLLBACK ::= CAPTURE(x,'😀') LOOKAHEAD(CAPTURE(x,'a'))
    (CAPTURE(x,'a') '!' | 'a') CHILD SAME_AS(x);
  token PURE ::= CAPTURE(x,'a') [CAPTURE(x,'b') '!'] SAME_AS(x);
  token BOUNDED ::= 'a'{2,3} 'b'? ['c'] {'d'};
  token UNICODE ::= CHAR_RANGE('😀','🙏')+;
  token POSITION ::= BOF 'a' NL BOL 'b' EOL EOF;
  token EMPTY_TOKEN ::= LOOKAHEAD(EOF) NEGATIVE_LOOKAHEAD(ANY);
  // Names must not accidentally select the built-in predictor or whitespace parser.
  token WORD ::= '😀';
  token SPACE ::= 'x';
  @root @mapping(Value, params=[value])
  Root ::= NUMBER @value;
}
