// 😀 custom implementation references are data, not code to execute
grammar Custom {
  @tokenAdapter: {
    id: 'example.word'
    version: '1'
    java: 'org.unlaxer.dsl.codegen.CustomAdapterParser'
    rust: 'crate::word_token'
  }
  token WORD = ADAPTER('example.word', version=1)
  token END = EOF
  @root @mapping(Value, params=[value]) Root ::= WORD @value;
}
