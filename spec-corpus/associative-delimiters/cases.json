    "name": "SharedDelimiterLevels",
    "grammar": "grammar SharedDelimiterLevels { @package: preferredprobe @whitespace: none token NUMBER = org.unlaxer.parser.elementary.NumberParser @root @mapping(Binary,params=[left,op,right]) @leftAssoc @precedence(level=10) Expr ::= '[' Term @left { '-' @op Term @right } ']'; @mapping(Binary,params=[left,op,right]) @leftAssoc @precedence(level=20) Term ::= '(' 'a' @left { '/' @op 'a' @right } ')'; }",
    "java": "protected String evalBinary(SharedDelimiterLevelsAST.Binary n){if(n.left()==null){if(n.op().size()!=1||!n.right().isEmpty())throw new AssertionError();return \"L:\"+n.op().get(0);}return \"B(\"+eval(n.left())+\",\"+String.join(\"|\",n.op())+\",\"+n.right().stream().map(this::eval).collect(java.util.stream.Collectors.joining(\"|\"))+\")\";}",
    "rust": "fn eval_binary(&mut self,left:Option<&Ast>,op:&[String],right:&[Ast],_:unlaxer_runtime::Span)->String{if let Some(left)=left {format!(\"B({},{},{})\",evaluate(left,self),op.join(\"|\"),right.iter().map(|n|evaluate(n,self)).collect::<Vec<_>>().join(\"|\"))}else{assert_eq!(op.len(),1);assert!(right.is_empty());format!(\"L:{}\",op[0])}}",
