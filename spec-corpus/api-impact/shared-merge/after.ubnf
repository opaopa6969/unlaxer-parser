// 😀 API impact corpus
grammar Impact {
  @package: org.example.impact
  token NUMBER = NumberParser
  @root Entry ::= First | Second;
  @mapping(Left, params=[value]) First ::= NUMBER @value;
  @mapping(Left, params=[value]) Second ::= Child @value;
  @mapping(Child, params=[text]) Child ::= 'x' @text;
}
