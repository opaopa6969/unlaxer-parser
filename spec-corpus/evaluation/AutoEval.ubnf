grammar AutoEval {
  @package: org.example.autoeval
  token TEXT = UNTIL(')')
  token NUM = NumberParser
  @root Root ::= SharedConditional | GroupConditional | BinaryInteger | Shadow | Conditional | Binary | Pass | Variable | Leaf | Manual | Unknown;
  @mapping(Leaf, params=[value]) Shadow ::= 'x(' TEXT @value ')';
  @mapping(Leaf, params=[value])
  @eval(kind='literal')
  Leaf ::= 'l(' TEXT @value ')';
  @mapping(Pass, params=[value])
  @eval(kind='passthrough')
  Pass ::= 'p(' Leaf @value ')';
  @mapping(Variable, params=[name])
  @eval(kind='variable_ref', strip_prefix='😀')
  Variable ::= 'v(' TEXT @name ')';
  @mapping(Binary, params=[left, op, right])
  @eval(kind='binary_arithmetic')
  Binary ::= 'b(' Leaf @left { '+' @op Leaf @right } ')';
  @mapping(BinaryInteger, params=[left, op, right])
  @eval(kind='binary_arithmetic')
  BinaryInteger ::= 'i(' NUM @left { '+' @op NUM @right } ')';
  @mapping(Conditional, params=[condition, thenExpr, elseExpr])
  @eval(kind='conditional')
  Conditional ::= 'c(' Leaf @condition ',' Manual @thenExpr ',' Manual @elseExpr ')';
  @mapping(Conditional, params=[condition, thenExpr, elseExpr])
  SharedConditional ::= 'd(' Unknown @condition ',' Leaf @thenExpr ',' Unknown @elseExpr ')';
  @mapping(Conditional, params=[condition, thenExpr, elseExpr])
  GroupConditional ::= 'g(' (Leaf | Unknown) @condition ',' (Manual | Leaf) @thenExpr ',' (Manual | Unknown) @elseExpr ')';
  @mapping(Manual, params=[value])
  @eval(kind='literal', strategy='manual')
  Manual ::= 'm(' TEXT @value ')';
  @mapping(Unknown, params=[value])
  @eval(kind='user_operation')
  Unknown ::= 'u(' TEXT @value ')';
}
